{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Launch Servers",
      "configurations": [
        "Launch GO",
        "Launch Node",
      ],
      "stopAll": true
    }
  ],
  "configurations": [
    {
      "name": "Launch GO",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/backend/cmd/console",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "env": {
        "PORT": "4000"
      }
    },
    {
      "name": "Launch Node",
      "type": "node-terminal",
      "request": "launch",
      "command": "killall node || true; npm run plugins:no-backend",
      "preLaunchTask": "Wait-A-Sec",
      "outFiles": [
        "${workspaceFolder}/**/*.js",
        "!**/node_modules/**"
      ]
    },
    {
      "name": "Launch Chrome",
      "request": "launch",
      "type": "chrome",
      "webRoot": "${workspaceFolder}/frontend",
      "outFiles": [
        "${workspaceFolder}/frontend/build/**/*.js",
        "!**/node_modules/**"
      ],
      "url": "http://localhost:9000"
    },
  ]
}
