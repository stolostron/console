{
  "name": "@patternfly-labs/react-form-wizard",
  "version": "2.8.0",
  "description": "A Patternfly react wizard framework.",
  "license": "Apache-2.0",
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "files": [
    "lib",
    "src",
    "wizards"
  ],
  "scripts": {
    "build": "rimraf lib && tsc6 && npm run build:copy:src && npm run build:copy:wizards",
    "build:copy:src": "cpy 'src/**/*.svg' 'src/**/*.css' lib/src",
    "build:copy:wizards": "cpy 'wizards/**/*.svg' 'wizards/**/*.yaml' 'wizards/**/*.hbs' lib/wizards",
    "start": "rspack serve --mode development --open",
    "start:quiet": "rspack serve --mode development",
    "pages": "rspack build --mode production",
    "test": "concurrently npm:tsc npm:lint npm:prettier npm:cypress npm:pages --prefix-colors cyan,green,blue,magenta,gray",
    "tsc": "tsc --noEmit -p tsconfig.eslint.json",
    "lint": "eslint src wizards --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "prettier": "prettier --check src wizards !**/*.hbs",
    "prettier:fix": "prettier --write src wizards !**/*.hbs",
    "cypress": "concurrently npm:start:quiet npm:cypress:run --prefix-colors cyan,green --kill-others --success first",
    "cypress:open": "cypress open",
    "cypress:run": "npm run cypress:wait && cypress run --config video=false",
    "cypress:wait": "curl --no-progress-meter --retry-connrefused --retry 5 --retry-delay 5 'localhost:3000' 1>/dev/null",
    "upgrade": "ncu --upgrade --doctor --target latest --reject react-router-dom,@types/node && ncu --upgrade --doctor --target minor && ncu --upgrade --doctor --target patch",
    "coverage": "open coverage/lcov-report/index.html",
    "watch": "npm run watch:init && watch 'npm run watch:build' src wizards",
    "watch:init": "tsc6 && npm run build:copy:src && npm run build:copy:wizards",
    "watch:build": "tsc6 --build tsconfig.eslint.json"
  },
  "prettier": "@stolostron/prettier-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patternfly-labs/react-form-wizard.git"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-router": "^7"
  },
  "dependencies": {
    "@patternfly/react-core": "^6.7.0",
    "@patternfly/react-icons": "^6.7.0",
    "@patternfly/react-table": "^6.7.0",
    "@react-hook/resize-observer": "^2.0.2",
    "get-value": "3.0.1",
    "klona": "2.0.6",
    "set-value": "4.1.0",
    "yaml": "1.10.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@cypress/code-coverage": "^4.0.3",
    "@rspack/cli": "^2.2.9",
    "@rspack/core": "^2.2.9",
    "@rspack/dev-server": "^2.2.2",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "@svgr/webpack": "^8.1.0",
    "@types/get-value": "3.0.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/set-value": "4.0.3",
    "@types/validator": "^13.15.10",
    "babel-loader": "^10.1.1",
    "babel-plugin-istanbul": "^7.0.1",
    "concurrently": "9.2.5",
    "cpy-cli": "6.0.0",
    "css-loader": "^7.1.5",
    "fuse.js": "6.6.2",
    "react-refresh": "^0.19.0",
    "react-router": "^7.18.4",
    "rimraf": "3.0.2",
    "style-loader": "3.3.4",
    "tsconfig-paths": "^4.2.0",
    "type-fest": "2.19.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "validator": "^13.15.35",
    "watch": "^1.0.2"
  },
  "optionalDependencies": {
    "cypress": "^15.21.1"
  }
}
