# Copyright Contributors to the Open Cluster Management project

-include /opt/build-harness/Makefile.prow

.PHONY: install
install:
	npm ci --omit=optional
	npm run postinstall

.PHONY: build
build:
	npm run build

.PHONY: check
check:
# HOME is /tmp in Prow; use /var/tmp's trusted sticky root for SWC's temporary cache.
	XDG_CACHE_HOME=/var/tmp SWC_NATIVE_BINDING_CACHE=0 npm run check

.PHONY: lint
lint:
	npm run lint

.PHONY: unit-tests
unit-tests:
	if [ ! -d "test-output" ]; then \
		mkdir test-output; \
	fi
	npm run test -- --maxWorkers=2
