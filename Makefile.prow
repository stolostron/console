# Copyright Contributors to the Open Cluster Management project

-include /opt/build-harness/Makefile.prow

.PHONY: install
install:
	npm ci --omit=optional
	npm run postinstall

.PHONY: build
build:
	npm run build

.PHONY: check
check:
# Prow check pods are isolated, so bypass SWC's cache-path ownership check here.
	SWC_NATIVE_BINDING_CACHE=0 SWC_NATIVE_BINDING_CACHE_SKIP_SECURITY_CHECK=1 npm run check

.PHONY: lint
lint:
	npm run lint

.PHONY: unit-tests
unit-tests:
	if [ ! -d "test-output" ]; then \
		mkdir test-output; \
	fi
	npm run test -- --maxWorkers=2
