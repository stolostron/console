# Copyright Contributors to the Open Cluster Management project

-include /opt/build-harness/Makefile.prow

.PHONY: install
install:
	npm ci --omit=optional
	npm run postinstall

.PHONY: build
build:
	npm run build

.PHONY: check
check:
# SWC 1.16.13 rejects Prow's shared /tmp/.cache root; use the private npm install tree.
	SWC_NATIVE_BINDING_CACHE="$(CURDIR)/frontend/node_modules/.cache/swc-native" npm run check

.PHONY: lint
lint:
	npm run lint

.PHONY: unit-tests
unit-tests:
	if [ ! -d "test-output" ]; then \
		mkdir test-output; \
	fi
	npm run test -- --maxWorkers=2
